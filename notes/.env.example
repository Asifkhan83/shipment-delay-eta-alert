# Resend settings: names only. Safe to commit.
# Do NOT copy this file into the repo with real values.
# Set these as user-level environment variables on your machine instead.
# See notes/resend-live-setup.md for the commands on Windows, macOS and Linux.
# If none are set, .mcp.json falls back to practice mode.

# Live mode: set all three, or none.
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
SENDER_EMAIL_ADDRESS=onboarding@resend.dev
